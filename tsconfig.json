{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
