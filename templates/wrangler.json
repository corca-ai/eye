{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "eye",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITES",
        "class_name": "SiteControl"
      }
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "eye-events"
      }
    ],
    "consumers": [
      {
        "queue": "eye-events",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "eye-events-failed"
      }
    ]
  },
  "exports": {
    "SiteControl": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
